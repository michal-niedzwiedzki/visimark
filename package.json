{
  "name": "visimark-monorepo",
  "private": true,
  "description": "Monorepo for VisiMark: spreadsheet mechanics for Markdown, plus its editor integrations.",
  "keywords": [
    "agent",
    "ai",
    "claude",
    "cli",
    "csv",
    "formulas",
    "markdown",
    "spreadsheet",
    "vscode"
  ],
  "homepage": "https://michal-niedzwiedzki.github.io/visimark/",
  "bugs": "https://github.com/michal-niedzwiedzki/visimark/issues",
  "license": "MIT",
  "author": "Michał Niedźwiedzki <michal@epsi.pl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michal-niedzwiedzki/visimark.git"
  },
  "workspaces": [
    "packages/*",
    "editors/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen:docs": "bun scripts/gen-docs.ts && bun scripts/gen-function-reference.ts",
    "gen:mcp": "bun scripts/gen-mcp-skill.ts",
    "gen:articles": "bun scripts/gen-articles.ts",
    "serve": "bun scripts/serve.mjs",
    "vscode-install": "cd editors/vscode && bun run install-local",
    "vscode-uninstall": "cd editors/vscode && bun run uninstall-local",
    "postinstall": "bun run --filter visimark build"
  },
  "dependencies": {
    "visimark": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "decode-named-character-reference": "^1.3.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5"
  },
  "packageManager": "bun@1.4.2"
}
