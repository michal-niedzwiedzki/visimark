{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  // The published entry and what it imports, nothing else: the declarations
  // `exports` can reach. src/browser.ts and src/browser/ are bundled from
  // source by the browser clients and the site, never from dist/, and a
  // declaration nobody can import is surface nobody meant to publish.
  "files": ["src/index.ts"]
}
