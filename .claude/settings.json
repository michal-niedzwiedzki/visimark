{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git rm *)",
      "Bash(git add *)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git rebase --skip)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh workflow *)",
      "Bash(gh run *)",
      "Skill(issue-prepare)",
      "Skill(issue-prepare:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/format-and-lint.sh\"",
            "statusMessage": "oxfmt + oxlint"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/visimark-check.sh\"",
            "statusMessage": "visimark check"
          }
        ]
      }
    ]
  }
}
