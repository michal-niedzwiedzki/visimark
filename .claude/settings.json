{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(git rm *)", "Bash(git add *)", "Bash(git rebase *)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.agents/hooks/format-and-lint.sh\"",
            "statusMessage": "oxfmt + oxlint"
          }
        ]
      }
    ]
  }
}
