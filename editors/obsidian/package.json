{
  "name": "visimark-obsidian",
  "private": true,
  "description": "The Obsidian client for VisiMark, a document integrity layer for Markdown: the numbers in a note, checked where the note is read.",
  "license": "MIT",
  "author": {
    "name": "Michał Niedźwiedzki"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michal-niedzwiedzki/visimark",
    "directory": "editors/obsidian"
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:scanner": "cd ../.. && eslint --config editors/obsidian/eslint.scanner.config.mjs $(git ls-files -- '*.ts' '*.mts' '*.cts' '*.js' '*.mjs' '*.cjs' ':!docs/vendor/**')",
    "build": "bun esbuild.config.mjs"
  },
  "dependencies": {
    "codemirror-visimark": "workspace:*",
    "visimark": "workspace:*",
    "visimark-editor-shared": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@happy-dom/global-registrator": "^20.14.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript-eslint": "^8.71.1"
  }
}
