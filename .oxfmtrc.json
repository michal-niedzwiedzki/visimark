{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // docs/vendor/ holds committed `bun build --minify` artifacts, not source (see
  // docs/reviews/2026-09-15.md §2.5 and the `playground-bundle` CI job). Formatting one
  // un-minifies it, and the next rebuild puts it back — a permanent `git diff` that
  // fails CI on every pull request. .oxlintrc.json skips the same directory, for the
  // same reason.
  //
  // docs/articles.html and docs/articles/*/index.html are committed generated output
  // of `bun run gen:articles` (scripts/gen-articles.ts), not source. Their shape comes
  // entirely from scripts/gen-articles-lib.ts's template functions; formatting the
  // generated HTML fights every future generator run the same way formatting
  // docs/vendor/** would fight the next bundle rebuild.
  "ignorePatterns": [
    "**/*.md",
    ".vscode/**",
    "docs/vendor/**",
    "docs/articles.html",
    "docs/articles/*/index.html"
  ]
}
