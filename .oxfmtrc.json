{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // docs/vendor/ holds committed `bun build --minify` artifacts, not source (see
  // docs/reviews/2026-09-15.md §2.5 and the `playground-bundle` CI job). Formatting one
  // un-minifies it, and the next rebuild puts it back — a permanent `git diff` that
  // fails CI on every pull request. .oxlintrc.json skips the same directory, for the
  // same reason.
  //
  // editors/obsidian/src/templates.ts is written by
  // scripts/gen-obsidian-templates.ts and checked against its sources by
  // editors/obsidian/test/templates.test.ts, byte for byte. Formatting it
  // rewrites the quoting of string literals that hold Markdown full of
  // double quotes, so the committed file stops matching what the generator
  // would write and the freshness check fails for a reason that has nothing
  // to do with the templates. Edit the Markdown in editors/obsidian/templates/
  // and run `bun run gen:obsidian-templates`.
  //
  // docs/articles.html, docs/articles/*/index.html, docs/examples.html,
  // docs/examples/*/index.html, docs/ci.html, docs/tutorial.html,
  // docs/simulate.html and docs/mcp-server.html are committed generated output of `bun run gen:articles`
  // (scripts/gen-articles.ts) and `bun run gen:docs` (scripts/gen-docs.ts), not source.
  // Their shape comes entirely from gen-articles-lib.ts's and gen-docs-lib.ts's
  // template functions; formatting the generated HTML fights every future generator
  // run the same way formatting docs/vendor/** would fight the next bundle rebuild.
  "ignorePatterns": [
    "**/*.md",
    ".vscode/**",
    "docs/vendor/**",
    "editors/obsidian/src/templates.ts",
    "docs/articles.html",
    "docs/articles/*/index.html",
    "docs/examples.html",
    "docs/examples/*/index.html",
    "docs/ci.html",
    "docs/tutorial.html",
    "docs/simulate.html",
    "docs/mcp-server.html"
  ]
}
